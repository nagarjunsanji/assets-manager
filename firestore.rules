rules_version = '2';

// Every record lives under users/{uid}/... so each user can only ever touch their own data.
service cloud.firestore {
  match /databases/{database}/documents {

    function googleAccount() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isAdmin() {
      return googleAccount()
        && request.auth.token.email == 'nagarjun.sanji@gmail.com';
    }

    function isApprovedUser(uid) {
      return isAdmin()
        || (googleAccount()
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/accessRequests/$(uid))
          && get(/databases/$(database)/documents/accessRequests/$(uid)).data.approved == true);
    }

    function isOwner(uid) {
      return isApprovedUser(uid) && request.auth.uid == uid;
    }

    function allowedCollection(name) {
      return name in [
        'assets', 'properties', 'agricultureLands', 'farms', 'livestock', 'lending',
        'stocks', 'mutualFunds', 'fixedDeposits', 'insurance', 'vehicles',
        'liabilities', 'goals', 'documents', 'networthHistory'
      ];
    }

    function validPayload(collection) {
      return request.resource.data.size() <= 60
        && (!('id' in request.resource.data))
        && (collection != 'documents'
          || !('contentData' in request.resource.data)
          || (request.resource.data.contentData is string
            && request.resource.data.contentData.size() <= 960000));
    }

    match /accessRequests/{uid} {
      allow get: if isAdmin() || (googleAccount() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if googleAccount()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'approved', 'requestedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.approved == false
        && request.resource.data.requestedAt is number;
      allow update, delete: if isAdmin();
    }

    // User profile document (users collection)
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.data.size() <= 40;

      match /{collection}/{docId} {
        allow read, delete: if isOwner(uid) && allowedCollection(collection);
        allow create, update: if isOwner(uid) && allowedCollection(collection) && validPayload(collection);
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
